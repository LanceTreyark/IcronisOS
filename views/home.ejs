<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Sentinel RC Aircraft Test</title>


    <style>

        @import url('/resources/BigShouldersStencil-VariableFont_opsz\,wght.ttf');


        * {
            box-sizing: border-box;
        }


        body {

            background: black;

            color: white;

            margin: 0;

            padding: 0;

            font-family:
                "Big Shoulders Stencil",
                sans-serif;

        }


        .page {

            min-height: 100vh;

            padding: 15px;

        }


        .video-container {

            display: flex;

            gap: 10px;

            width: 100%;

            height: 55vh;

        }


        .video-box {

            position: relative;

            flex: 1;

            background: #111;

            overflow: hidden;

        }


        .video-box img.stream {

            display: block;

            width: 100%;

            height: 100%;

            object-fit: cover;

        }


        .gamepad-icon {

            position: absolute;

            z-index: 5;

            top: 20px;

            left: 30px;

            width: 45px;

            height: auto;

            display: none;

        }


        .hud {

            position: absolute;

            z-index: 10;

            top: 20px;

            left: 20px;

            background: rgba(0, 0, 0, 0.75);

            padding: 12px;

            border-radius: 8px;

            min-width: 200px;

            font-size: 18px;

        }


        .hud-title {

            font-size: 25px;

            margin-bottom: 8px;

        }


        .status-safe {

            color: limegreen;

        }


        .status-danger {

            color: red;

        }


        .controls {

            margin: 15px auto;

            max-width: 900px;

            display: grid;

            grid-template-columns:
                repeat(3, 1fr);

            gap: 10px;

        }


        .control {

            background: #151515;

            border: 1px solid #444;

            border-radius: 8px;

            padding: 12px;

            text-align: center;

        }


        .control-name {

            font-size: 18px;

        }


        .control-value {

            font-size: 30px;

            margin-top: 5px;

        }


        .instructions {

            max-width: 900px;

            margin: 20px auto;

            background: #101010;

            border: 1px solid #333;

            padding: 15px;

            border-radius: 8px;

            font-family: Arial, sans-serif;

            line-height: 1.6;

        }


        .kill {

            color: red;

            font-weight: bold;

        }


        @media (max-width: 700px) {

            .video-container {

                height: 40vh;

            }


            .controls {

                grid-template-columns:
                    repeat(2, 1fr);

            }

        }

    </style>

</head>


<body>


<div class="page">


    <!-- =====================================================
         CAMERA DISPLAY
         ===================================================== -->

    <div class="video-container">


        <div class="video-box">


            <div class="hud">

                <div class="hud-title">
                    SENTINEL
                </div>


                <div>
                    MOTOR:
                    <span
                        id="motorStatus"
                        class="status-danger"
                    >
                        KILLED
                    </span>
                </div>


                <div>
                    THROTTLE:
                    <span id="throttle">
                        0%
                    </span>
                </div>


                <div>
                    FLAPS:
                    <span id="flaps">
                        UP
                    </span>
                </div>


                <div>
                    BATTERY:
                    <span id="battery">
                        --V
                    </span>
                </div>


                <div>
                    CONTROLLER:
                    <span
                        id="controller"
                        class="status-danger"
                    >
                        DISCONNECTED
                    </span>
                </div>

            </div>


            <img
                class="gamepad-icon"
                src="../resources/gamePad4Connected.svg"
                alt="Gamepad Connected"
            >


            <img
                class="stream"
                src="http://192.168.1.72:8090/?action=stream"
                alt="FPV Camera"
            >

        </div>


        <div class="video-box">


            <div class="hud">

                <div>
                    YAW:
                    <span id="yaw">
                        0
                    </span>
                </div>

                <div>
                    ROLL:
                    <span id="roll">
                        0
                    </span>
                </div>

                <div>
                    PITCH:
                    <span id="pitch">
                        0
                    </span>
                </div>

            </div>


            <img
                class="gamepad-icon"
                src="../resources/gamePad4Connected.svg"
                alt="Gamepad Connected"
            >


            <img
                class="stream"
                src="http://192.168.1.72:8090/?action=stream"
                alt="FPV Camera"
            >

        </div>

    </div>


    <!-- =====================================================
         CONTROL STATUS
         ===================================================== -->

    <div class="controls">


        <div class="control">

            <div class="control-name">
                YAW
            </div>

            <div
                class="control-value"
                id="yawControl"
            >
                0
            </div>

        </div>


        <div class="control">

            <div class="control-name">
                ROLL
            </div>

            <div
                class="control-value"
                id="rollControl"
            >
                0
            </div>

        </div>


        <div class="control">

            <div class="control-name">
                PITCH
            </div>

            <div
                class="control-value"
                id="pitchControl"
            >
                0
            </div>

        </div>


        <div class="control">

            <div class="control-name">
                THROTTLE
            </div>

            <div
                class="control-value"
                id="throttleControl"
            >
                0%
            </div>

        </div>


        <div class="control">

            <div class="control-name">
                FLAPS
            </div>

            <div
                class="control-value"
                id="flapsControl"
            >
                UP
            </div>

        </div>


        <div class="control">

            <div class="control-name">
                MOTOR
            </div>

            <div
                class="control-value"
                id="motorControl"
            >
                KILLED
            </div>

        </div>

    </div>


    <!-- =====================================================
         CONTROLLER INSTRUCTIONS
         ===================================================== -->

    <div class="instructions">

        <strong>Xbox Controller</strong>
        <br><br>

        Left stick ← → : YAW
        <br>

        Right stick ← → : ROLL
        <br>

        Right stick ↑ ↓ : PITCH
        <br><br>

        D-pad UP : THROTTLE +5%
        <br>

        D-pad DOWN : THROTTLE -5%
        <br><br>

        Y : FLAPS UP / DOWN
        <br>

        <span class="kill">
            B : MOTOR KILL
        </span>

        <br>

        A : ARM / RESET MOTOR KILL

        <br><br>

        <strong>Safety:</strong>

        B immediately forces the ESC
        to 1000 µs.

        A clears the motor kill but
        leaves throttle at 0%.

        Controller communication loss
        activates the failsafe.

    </div>


</div>


<script src="/socket.io/socket.io.js"></script>


<script>


// ============================================================
// GAMEPAD STATE
// ============================================================

let gamepadIndex = null;


let previousButtons = {

    a: false,

    b: false,

    y: false,

    dpadUp: false,

    dpadDown: false

};


let controllerConnected = false;


// ============================================================
// SEND DATA TO RASPBERRY PI
// ============================================================

const sendToServer = (data) => {

    fetch(
        '/joystick',
        {
            method: 'POST',

            headers: {
                'Content-Type':
                    'application/json'
            },

            body:
                JSON.stringify(data)

        }
    )

    .then(response =>
        response.json()
    )

    .then(data => {

        if (
            data.throttlePercent !==
            undefined
        ) {

            updateThrottle(
                data.throttlePercent
            );

        }


        if (
            data.flapsDeployed !==
            undefined
        ) {

            updateFlaps(
                data.flapsDeployed
            );

        }


        if (
            data.motorKilled !==
            undefined
        ) {

            updateMotor(
                data.motorKilled
            );

        }

    })

    .catch(error => {

        console.error(
            'Controller communication error:',
            error
        );

    });

};


// ============================================================
// STICK CONVERSION
// Browser: -1...+1
// Server:  -100...+100
// ============================================================

const axisToPercent = (value) => {

    // Dead zone
    if (Math.abs(value) < 0.08) {

        return 0;

    }

    return Math.round(
        value * 100
    );

};


// ============================================================
// HUD
// ============================================================

function updateThrottle(value) {

    document.getElementById(
        'throttle'
    ).textContent = `${value}%`;

    document.getElementById(
        'throttleControl'
    ).textContent = `${value}%`;

}


function updateFlaps(deployed) {

    const text =
        deployed
            ? 'DOWN'
            : 'UP';

    document.getElementById(
        'flaps'
    ).textContent = text;

    document.getElementById(
        'flapsControl'
    ).textContent = text;

}


function updateMotor(killed) {

    const status =
        document.getElementById(
            'motorStatus'
        );

    const control =
        document.getElementById(
            'motorControl'
        );


    status.textContent =
        killed
            ? 'KILLED'
            : 'ARMED';


    control.textContent =
        killed
            ? 'KILLED'
            : 'ARMED';


    status.className =
        killed
            ? 'status-danger'
            : 'status-safe';

}


function updateController(connected) {

    const element =
        document.getElementById(
            'controller'
        );


    element.textContent =
        connected
            ? 'CONNECTED'
            : 'DISCONNECTED';


    element.className =
        connected
            ? 'status-safe'
            : 'status-danger';

}


function updateAxisDisplay(
    name,
    value
) {

    document.getElementById(
        name
    ).textContent = value;


    document.getElementById(
        `${name}Control`
    ).textContent = value;

}


// ============================================================
// GAMEPAD POLLING
// ============================================================

function pollGamepad() {

    if (gamepadIndex === null) {

        return;

    }


    const gamepads =
        navigator.getGamepads();


    const gamepad =
        gamepads[gamepadIndex];


    if (!gamepad) {

        return;

    }


    // ========================================================
    // XBOX AXES
    //
    // 0 = Left X
    // 1 = Left Y
    // 2 = Right X
    // 3 = Right Y
    // ========================================================

    const yaw =
        axisToPercent(
            gamepad.axes[0]
        );


    const roll =
        axisToPercent(
            gamepad.axes[2]
        );


    // Browser Y is positive downward,
    // so invert it for pitch.
    const pitch =
        axisToPercent(
            -gamepad.axes[3]
        );


    updateAxisDisplay(
        'yaw',
        yaw
    );


    updateAxisDisplay(
        'roll',
        roll
    );


    updateAxisDisplay(
        'pitch',
        pitch
    );


    // ========================================================
    // XBOX BUTTONS
    //
    // A = 0
    // B = 1
    // X = 2
    // Y = 3
    //
    // D-PAD:
    // UP    = 12
    // DOWN  = 13
    // LEFT  = 14
    // RIGHT = 15
    // ========================================================

    const aPressed =
        !!gamepad.buttons[0]?.pressed;


    const bPressed =
        !!gamepad.buttons[1]?.pressed;


    const yPressed =
        !!gamepad.buttons[3]?.pressed;


    const dpadUpPressed =
        !!gamepad.buttons[12]?.pressed;


    const dpadDownPressed =
        !!gamepad.buttons[13]?.pressed;


    // ========================================================
    // BUTTON EDGE DETECTION
    //
    // We only send a button command once when it is pressed.
    // ========================================================

    const aPressedEdge =
        aPressed &&
        !previousButtons.a;


    const bPressedEdge =
        bPressed &&
        !previousButtons.b;


    const yPressedEdge =
        yPressed &&
        !previousButtons.y;


    const dpadUpEdge =
        dpadUpPressed &&
        !previousButtons.dpadUp;


    const dpadDownEdge =
        dpadDownPressed &&
        !previousButtons.dpadDown;


    // ========================================================
    // SEND AIRCRAFT COMMAND
    // ========================================================

    sendToServer({

        yaw,

        roll,

        pitch,

        throttleUp:
            dpadUpEdge,

        throttleDown:
            dpadDownEdge,

        flapsToggle:
            yPressedEdge,

        motorKill:
            bPressedEdge,

        arm:
            aPressedEdge

    });


    // Save button state.
    previousButtons.a =
        aPressed;

    previousButtons.b =
        bPressed;

    previousButtons.y =
        yPressed;

    previousButtons.dpadUp =
        dpadUpPressed;

    previousButtons.dpadDown =
        dpadDownPressed;

}


// ============================================================
// FIND CONTROLLER
// ============================================================

function checkGamepadConnection() {

    const gamepads =
        navigator.getGamepads();


    let found = false;


    for (
        let i = 0;
        i < gamepads.length;
        i++
    ) {

        if (gamepads[i]) {

            gamepadIndex = i;

            found = true;

            break;

        }

    }


    controllerConnected =
        found;


    updateController(
        found
    );


    document
        .querySelectorAll(
            '.gamepad-icon'
        )
        .forEach(icon => {

            icon.style.display =
                found
                    ? 'block'
                    : 'none';

        });

}


// ============================================================
// CONTROLLER CONNECTED
// ============================================================

window.addEventListener(
    'gamepadconnected',
    (event) => {

        console.log(
            'Gamepad connected:',
            event.gamepad
        );


        gamepadIndex =
            event.gamepad.index;


        controllerConnected =
            true;


        updateController(
            true
        );


        checkGamepadConnection();

    }
);


// ============================================================
// CONTROLLER DISCONNECTED
// ============================================================

window.addEventListener(
    'gamepaddisconnected',
    () => {

        console.log(
            'Gamepad disconnected'
        );


        gamepadIndex =
            null;


        controllerConnected =
            false;


        updateController(
            false
        );

    }
);


// ============================================================
// START GAMEPAD POLLING
// ============================================================

window.addEventListener(
    'load',
    () => {

        checkGamepadConnection();

        // 20 Hz controller update rate.
        setInterval(
            pollGamepad,
            50
        );

    }
);


// ============================================================
// SOCKET.IO
// ============================================================

const socket =
    io();


socket.on(
    'connect',
    () => {

        console.log(
            'Socket.IO connected'
        );

    }
);


socket.on(
    'aircraftState',
    (state) => {

        updateThrottle(
            state.throttlePercent
        );

        updateFlaps(
            state.flapsDeployed
        );

        updateMotor(
            state.motorKilled
        );

    }
);


socket.on(
    'batteryVoltage',
    (voltage) => {

        document.getElementById(
            'battery'
        ).textContent =
            `${voltage}V`;

    }
);


socket.on(
    'disconnect',
    () => {

        console.log(
            'Socket.IO disconnected'
        );

    }
);


</script>


</body>

</html>